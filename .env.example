# Copy to .env for local overrides. Never commit .env.
# Compose reads these (via `make`); the monolith reads DATABASE_URL etc. when run on the host.

POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow
POSTGRES_DB=orderflow
POSTGRES_HOST_PORT=5432
MONOLITH_HOST_PORT=8000

# Used when running the monolith or `make migrate` from the host (not inside Compose).
DATABASE_URL=postgresql+asyncpg://orderflow:orderflow@localhost:5432/orderflow

# ISO 4217; all money is integer minor units of this currency.
CURRENCY=USD
LOG_LEVEL=INFO

# Phase 0 break-it toggle: false = naive read-check-write stock reservation (oversells).
ATOMIC_STOCK_RESERVATION=true
